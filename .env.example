PYTHONDONTWRITEBYTECODE=1
SUBTRANSLATE_IMAGE=subtranslate:v2.5.0
# Caminhos no host (ajuste para seu sistema; compose usa defaults ./shows e ./state se omitidos)
MEDIA_ROOT=/Tank/data/Shows
STATE_DIR=/docker/subtranslate/state
WEB_PORT=5050
BIND_ADDR=0.0.0.0
TRANSLATOR_PIPELINE=v2_3_8
TRANSLATOR_OLLAMA_URL=http://ollama.example.invalid:11434
TRANSLATOR_OLLAMA_MODEL=qwen3.5:9b
# Proteção preventiva para GPUs AMD durante jobs que usam Ollama.
TRANSASS_GPU_THERMAL_GUARD=1
TRANSASS_GPU_THERMAL_WARN_C=90
TRANSASS_GPU_THERMAL_STOP_C=100
TRANSASS_GPU_THERMAL_INTERVAL_S=1
# Confirmações consecutivas acima do limite preventivo antes de interromper.
TRANSASS_GPU_THERMAL_CONFIRMATIONS=2
# Janela de observação para permitir a curva de ventoinha estabilizar.
# A leitura e o log de telemetria ocorrem a cada 1s.
TRANSASS_GPU_THERMAL_COOLING_WINDOW_S=30
# Ao atingir o limite, suspende a proteção preventiva do app por esta janela.
# O driver/firmware continua controlando a proteção térmica do hardware.
TRANSASS_GPU_THERMAL_TRIP_OVERRIDE_S=60
# Só libera nova chamada quando a temperatura cair abaixo deste valor.
# Vazio usa alerta - 5°C (90 -> 85°C).
TRANSASS_GPU_THERMAL_RESUME_C=
# Backoff agnóstico para novas integrações fora do fluxo legado V2.3.8.
TRANSASS_THERMAL_GUARD=1
TRANSASS_THERMAL_THROTTLE_C=95
TRANSASS_THERMAL_COOLDOWN_C=85
TRANSASS_THERMAL_CRITICAL_C=105
TRANSASS_THERMAL_CHECK_INTERVAL_S=2
TRANSASS_THERMAL_MAX_WAIT_S=300
TRANSLATOR_FALLBACK_OLLAMA_MODEL=llama3.1:8b
TRANSLATOR_REVIEW_MODEL=llama3.1:8b
TRANSLATOR_BASE_LIBRARY=/shows
ANIME_SUBTITLE_LIBRARY_ROOT=/app/state/anime-subtitle-library
ANIME_LIBRARY_ROOTS=/shows
TRANSLATOR_WEB_STATE_DIR=/app/state
TRANSLATOR_GLOSSARY_PATH=/app/state/glossary_v1.json
TRANSLATOR_REVIEW_MAX_PER_FILE=30
TRANSLATOR_BATCH_SIZE=4
TRANSLATOR_CONTEXT_NEIGHBORS=1
TRANSLATOR_CONTEXT_MAX_CHARS=360
TRANSLATOR_MIN_FILE_AGE_SECONDS=600
# Teto físico por operação no Qwen/Ollama; protege contra loops de isolamento
# sem interromper episódios longos por usar um padrão pequeno demais.
V238_QWEN_PHYSICAL_MAXIMUM=256
# Motor de tradução (principal + fallback opcional)
TRANSPORT_PROVIDER=ollama
TRANSPORT_MODEL=qwen3.5:9b
TRANSPORT_FALLBACK_PROVIDER=gemini
TRANSPORT_FALLBACK_MODEL=gemini-3.5-flash-lite
# Idioma de origem das legendas (destino é sempre português do Brasil)
TRANSLATOR_SOURCE_LANGUAGE=inglês
# API keys: use variáveis de ambiente, NUNCA commite (arquivo .env é gitignored)
# Gemini (grátis) — pegue em https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy...
# Para usar Gemini como motor principal, troque as 2 linhas acima para:
# TRANSPORT_PROVIDER=gemini
# TRANSPORT_MODEL=gemini-3.5-flash-lite
# Groq / OpenRouter (OpenAI-compatível)
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# DeepSeek (API compatível com OpenAI)
# DEEPSEEK_API_KEY=sk-...
# NVIDIA NIM (modelo com namespace, por exemplo meta/llama-3.1-8b-instruct)
# NVIDIA_API_KEY=nvapi-...
